<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="navy">#0A1733</color>
    <color name="navy2">#132B4A</color>
    <color name="gold">#4F8DFF</color>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/navy</item>
        <item name="android:colorPrimaryDark">@color/navy</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:statusBarColor">#10264F</item>
        <item name="android:navigationBarColor">#0A1A38</item>
    </style>
    <style name="LockTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/fundo_trava</item>
        <item name="android:statusBarColor">#3B5F93</item>
        <item name="android:navigationBarColor">#4A4A5E</item>
        <item name="android:colorAccent">@color/gold</item>
    </style>
    <!-- atalho em pílula da tela de bloqueio -->
    <style name="Pilula">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/pill_vidro</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:drawablePadding">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#1B1A2E</item>
        <item name="android:textSize">17sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Atalho">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
</resources>
