<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="navy">#0A1733</color>
    <color name="navy2">#132B4A</color>
    <color name="gold">#4F8DFF</color>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/navy</item>
        <item name="android:colorPrimaryDark">@color/navy</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:statusBarColor">@color/navy</item>
    </style>
    <style name="LockTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:colorAccent">@color/gold</item>
    </style>
</resources>
