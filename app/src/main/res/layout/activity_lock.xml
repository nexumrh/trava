<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de bloqueio: cartão com a empresa, chave de acesso e IMEI, campo de PIN e atalhos em "pílulas" embaixo. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/fundo_trava" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="40dp" android:paddingBottom="22dp">

        <!-- cartão principal -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/card_vidro"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="22dp" android:paddingBottom="22dp">
            <TextView android:id="@+id/tvEmpresa" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="NEXUMCELL"
                android:textColor="#1B1A2E" android:textSize="21sp" android:textStyle="bold" android:letterSpacing="0.02"/>
            <TextView android:id="@+id/tvChave" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="#3B3A52" android:textSize="17sp" android:textIsSelectable="true"/>
            <TextView android:id="@+id/tvImei" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#3B3A52" android:textSize="17sp" android:textIsSelectable="true"/>
            <TextView android:id="@+id/tvMotivo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center" android:textColor="#3B3A52" android:textSize="17sp"/>
        </LinearLayout>

        <!-- PIN da loja (código de liberação) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="16dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/campo_pin">
            <EditText android:id="@+id/edPin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@android:color/transparent" android:hint="PIN" android:inputType="numberPassword"
                android:maxLength="10" android:imeOptions="actionDone" android:paddingStart="20dp" android:paddingEnd="8dp"
                android:textColor="#1B1A2E" android:textColorHint="#6B6A80" android:textSize="18sp" android:singleLine="true"/>
            <Button android:id="@+id/btnPin" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="8dp"
                android:minWidth="0dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:background="@drawable/btn_azul"
                android:text="Liberar" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
        </LinearLayout>

        <!-- valores (quando é atraso) -->
        <TextView android:id="@+id/tvMensagem" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="14sp"
            android:shadowColor="#66000000" android:shadowRadius="3"/>
        <TextView android:id="@+id/tvParcelas" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/card_vidro" android:padding="16dp"
            android:textColor="#1B1A2E" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
        <TextView android:id="@+id/tvPix" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/card_vidro" android:padding="14dp"
            android:gravity="center" android:textColor="#0E6F64" android:textSize="14sp"/>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp"/>

        <!-- atalhos -->
        <Button android:id="@+id/btnPagar" style="@style/Pilula" android:drawableStart="@drawable/ic_pix" android:text="Pagar agora com PIX"/>
        <Button android:id="@+id/btnVerificar" style="@style/Pilula" android:drawableStart="@drawable/ic_check" android:text="@string/ja_paguei"/>
        <Button android:id="@+id/btnConfianca" style="@style/Pilula" android:drawableStart="@drawable/ic_relogio" android:visibility="gone" android:text="Liberar por 24 h (1 vez por mês)"/>
        <Button android:id="@+id/btnPromessa" style="@style/Pilula" android:drawableStart="@drawable/ic_cal" android:visibility="gone" android:text="Prometer o pagamento"/>
        <Button android:id="@+id/btnLoja" style="@style/Pilula" android:drawableStart="@drawable/ic_ajuda" android:text="Suporte"/>
        <Button android:id="@+id/btnCodigo" style="@style/Pilula" android:visibility="gone" android:text="Tenho um código da loja"/>

        <Button android:id="@+id/btnEmergencia" android:layout_width="wrap_content" android:layout_height="40dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:background="@drawable/pill_escura"
            android:minWidth="0dp" android:paddingStart="22dp" android:paddingEnd="22dp"
            android:text="Chamada de emergência" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp"/>

        <TextView android:id="@+id/tvLoja" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center" android:textColor="#E6ECF5" android:textSize="12sp"/>
        <TextView android:id="@+id/tvRodape" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="#C9D3EA" android:textSize="11sp"/>
    </LinearLayout>
</ScrollView>
