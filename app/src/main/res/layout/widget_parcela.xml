<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgRaiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_fundo">
    <TextView android:id="@+id/wgTitulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="NexumCell · próxima parcela" android:textColor="#C9A227" android:textSize="12sp" android:textStyle="bold"/>
    <TextView android:id="@+id/wgValor" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="—" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
    <TextView android:id="@+id/wgVenc" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#C9D4EE" android:textSize="13sp"/>
    <TextView android:id="@+id/wgPagar" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:background="@drawable/btn_gold" android:paddingLeft="16dp" android:paddingRight="16dp"
        android:paddingTop="6dp" android:paddingBottom="6dp" android:text="Pagar" android:textColor="#0A1733" android:textSize="14sp" android:textStyle="bold"/>
</LinearLayout>
